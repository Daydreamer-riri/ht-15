{
  "name": "trip-route-plan",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:itinerary && npm run build:walk && npm run build:presentation && npm run build:atlas",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:itinerary": "vite build",
    "build:walk": "node scripts/build-walk.mjs",
    "build:presentation": "node scripts/build-presentation.mjs",
    "dev:presentation": "npm run build:presentation && vite preview --host 127.0.0.1 --port 8845",
    "test:walk": "node --test realtrip/tests/*.test.mjs",
    "test:migration": "node --test tests/migration.test.mjs",
    "build:atlas": "node scripts/build-atlas.mjs",
    "test:atlas": "node --test tests/route-model.test.mjs tests/sky-soho-route.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "clsx": "^2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "@playcanvas/supersplat-viewer": "1.37.0",
    "playcanvas": "2.23.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@ctrip/eslint-config-dingzhi": "^1.6.4",
    "@eslint/js": "^9.29.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "esbuild": "0.25.12",
    "qrcode": "1.5.4"
  },
  "packageManager": "pnpm@10.11.0"
}
